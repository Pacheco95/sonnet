<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive launcher icon: the launcher masks it to a circle or squircle itself, and shows the
     monochrome layer when the user turns on themed icons. The layers are generated by
     tools/generate_icons.py (docs/branding.md). minSdkVersion is 36, so no legacy icon is needed. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
