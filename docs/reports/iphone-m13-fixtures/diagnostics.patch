+      SONNET_LOG_INFO("validation statistics: history {}, known {}, draws {}, visible {}, triangles {}, visible triangles {}, shadow draws {}, visible shadows {}",
+                      stats.temporalHistoryUsed, stats.visibleCountsKnown, stats.drawCount, stats.visibleDrawCount,
+                      stats.triangleCount, stats.visibleTriangleCount, stats.shadowDrawCount, stats.visibleShadowDrawCount);
       SONNET_LOG_INFO("capture frame times {}", m_frameTimes.summary());
