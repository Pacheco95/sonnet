--- a/apps/player/main.cpp
+++ b/apps/player/main.cpp
@@ -50,6 +50,13 @@ using namespace sonnet;
   runtime::GameDesc desc;
   // A capture run draws its settle frames before it plays, as the editor's does.
   desc.paused = line.capture.has_value();
+  if (line.capture) {
+    const auto name = line.capture->viewport.filename().string();
+    desc.renderer.occlusionCulling = name.find("nocull") == std::string::npos;
+    if (name.starts_with("shadow") || name.starts_with("occlusion")) {
+      desc.renderer.antialiasing = renderer::AntiAliasing::None;
+    }
+  }
   return desc;
 }

