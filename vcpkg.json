{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "sonnet",
  "version-string": "0.2.0",
  "builtin-baseline": "a1cae005c39be7b18ba319fced856b68d7276271",
  "dependencies": [
    {
      "name": "sdl3",
      "default-features": false,
      "features": [
        "vulkan",
        {
          "name": "x11",
          "platform": "linux"
        },
        {
          "name": "wayland",
          "platform": "linux"
        }
      ]
    },
    "vulkan-headers",
    "vulkan-loader",
    "vk-bootstrap",
    "vulkan-memory-allocator-hpp",
    "shader-slang",
    "glm",
    "spdlog",
    "tracy",
    "catch2",
    "flecs",
    "nlohmann-json",
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "sdl3-binding",
        "vulkan-binding"
      ]
    }
  ]
}
